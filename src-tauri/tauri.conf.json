{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZettelQuick",
  "version": "0.1.0",
  "identifier": "com.zettelquick.capture",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZettelQuick",
        "width": 640,
        "height": 360,
        "minWidth": 380,
        "minHeight": 200,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
